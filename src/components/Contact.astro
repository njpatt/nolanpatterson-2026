---

---

<section class="section contact-section" id="contact">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-5">
        <span class="eyebrow d-block mb-2" style="color: var(--clay);"
          >Contact</span
        >
        <h2 class="display-6 fw-bold mb-3">Let&apos;s make something.</h2>
        <p
          class="mb-4"
          style="color: rgba(244,238,227,0.75); max-width: 30rem;"
        >
          Have a project in mind, or just want to say hello? I&apos;m always up
          for a good conversation about code, craft, or clay.
        </p>
        <ul class="list-unstyled d-flex flex-column gap-2">
          <li>
            <span
              class="d-block small text-uppercase"
              style="letter-spacing:0.12em; color: rgba(244,238,227,0.5);"
              >Email</span
            >
            <a class="contact-link" href="mailto:njpatt@gmail.com"
              >njpatt@gmail.com</a
            >
          </li>
          <li class="mt-2">
            <span
              class="d-block small text-uppercase"
              style="letter-spacing:0.12em; color: rgba(244,238,227,0.5);"
              >Socials</span
            >
            <a
              class="contact-link me-3"
              href="https://www.upwork.com/freelancers/nolanpatterson"
              target="_blank">Upwork</a
            >
            <a
              class="contact-link me-3"
              href="https://www.linkedin.com/in/nolanpatterson/"
              target="_blank">LinkedIn</a
            >
            <a
              class="contact-link"
              href="https://www.instagram.com/grooveneststudio/"
              target="_blank">Instagram</a
            >
          </li>
        </ul>
      </div>

      <div class="col-lg-7">
        <form class="row g-3" id="contactForm" novalidate>
          <div class="col-md-6">
            <label class="form-label small" for="name">Name</label>
            <input
              class="form-control contact-input"
              id="name"
              name="name"
              type="text"
              placeholder="Your name"
              required
            />
          </div>
          <div class="col-md-6">
            <label class="form-label small" for="email">Email</label>
            <input
              class="form-control contact-input"
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
            />
          </div>
          <div class="col-12">
            <label class="form-label small" for="subject">Subject</label>
            <input
              class="form-control contact-input"
              id="subject"
              name="subject"
              type="text"
              placeholder="What's this about?"
            />
          </div>
          <div class="col-12">
            <label class="form-label small" for="message">Message</label>
            <textarea
              class="form-control contact-input"
              id="message"
              name="message"
              rows="5"
              placeholder="Tell me a little about your project…"
              required></textarea>
          </div>
          <div class="col-12 d-flex align-items-center gap-3">
            <button type="submit" class="btn btn-clay">Send message</button>
            <span
              id="formStatus"
              class="small"
              style="color: var(--clay);"
              role="status"></span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  const status = document.getElementById("formStatus");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.classList.add("was-validated");
      if (status) status.textContent = "Please fill in the required fields.";
      return;
    }
    if (status)
      status.textContent =
        "Thanks! This is a demo form — wire it up to your inbox.";
    form.reset();
    form.classList.remove("was-validated");
  });
</script>
