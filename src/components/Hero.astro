---
const slides = [
  {
    tag: "Featured · SaaS",
    title: "Meridian Analytics",
    desc: "A real-time analytics dashboard helping teams turn raw data into clear decisions.",
    img: "/images/project-dashboard.png",
    alt: "Meridian Analytics dashboard on a laptop",
  },
  {
    tag: "Featured · E-commerce",
    title: "Terra Goods Storefront",
    desc: "A fast, mobile-first storefront with a checkout flow that converts.",
    img: "/images/project-mobile.png",
    alt: "Terra Goods mobile storefront app",
  },
  {
    tag: "Featured · Web App",
    title: "Fieldnote Platform",
    desc: "A collaborative research platform built for speed and accessibility.",
    img: "/images/project-webapp.png",
    alt: "Fieldnote web application on a desktop monitor",
  },
]
---

<section class="hero" id="top">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-5" data-hero-text>
        <span class="eyebrow d-block mb-3">Web Developer &amp; Maker</span>
        <h1 class="display-3 fw-bold mb-4" style="line-height: 1.05;">
          I build considered digital products.
        </h1>
        <p class="fs-5 text-muted-earth mb-4" style="max-width: 34rem;">
          Hi, I&apos;m Nolan — a developer who cares equally about clean code and
          craft. I ship professional web work and tinker with creative projects
          in between.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="#work" class="btn btn-clay">View selected work</a>
          <a href="#contact" class="btn btn-outline-earth">Get in touch</a>
        </div>
      </div>

      <div class="col-lg-7" data-hero-media>
        <div class="card-stack" data-card-stack role="group" aria-label="Featured projects">
          {
            slides.map((slide, i) => (
              <article
                class="stack-card"
                data-stack-card
                aria-hidden={i === 0 ? "false" : "true"}
              >
                <img src={slide.img} alt={slide.alt} />
                <div class="stack-caption text-start d-none d-md-block">
                  <span class="slide-tag mb-2">{slide.tag}</span>
                  <h3 class="h5 mb-1">{slide.title}</h3>
                  <p class="mb-0 small">{slide.desc}</p>
                </div>
              </article>
            ))
          }
        </div>

        <div class="stack-nav">
          <button
            type="button"
            class="stack-btn"
            data-stack-prev
            aria-label="Previous project"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="stack-dots">
            {
              slides.map((slide, i) => (
                <button
                  type="button"
                  class={`stack-dot ${i === 0 ? "active" : ""}`}
                  data-stack-dot
                  aria-label={`Show ${slide.title}`}
                />
              ))
            }
          </div>
          <button
            type="button"
            class="stack-btn"
            data-stack-next
            aria-label="Next project"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <a href="#work" class="scroll-cue text-decoration-none" aria-label="Scroll to work">
    <span>Scroll</span>
    <span class="line"></span>
  </a>
</section>

<script>
  import { gsap } from "gsap"

  const initStack = () => {
    const stack = document.querySelector<HTMLElement>("[data-card-stack]")
    if (!stack) return

    const cards = Array.from(stack.querySelectorAll<HTMLElement>("[data-stack-card]"))
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-stack-dot]"))
    const total = cards.length
    if (total === 0) return

    // Cards fan diagonally at a 45-degree direction (equal x/y offset) behind
    // the front card, with a subtle rotation for a hand-of-cards feel.
    const OFFSET = 30 // px along both axes => 45deg diagonal
    const ROT = 6 // deg of tilt per card behind
    const SCALE = 0.05 // shrink per card behind

    // order[position] = card index. Position 0 is the front card.
    let order = cards.map((_, i) => i)
    let animating = false

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    const layout = (animate = true) => {
      order.forEach((cardIdx, pos) => {
        const card = cards[cardIdx]
        gsap.to(card, {
          x: pos * OFFSET,
          y: pos * OFFSET,
          rotation: pos * ROT,
          scale: 1 - pos * SCALE,
          opacity: pos > 2 ? 0 : 1,
          duration: animate && !reduceMotion ? 0.6 : 0,
          ease: "power3.out",
        })
        card.style.zIndex = String(total - pos)
        card.setAttribute("aria-hidden", pos === 0 ? "false" : "true")
      })
      const front = order[0]
      dots.forEach((dot, i) => dot.classList.toggle("active", i === front))
    }

    const next = () => {
      if (animating) return
      animating = true
      const front = cards[order[0]]
      gsap.to(front, {
        y: "-=70",
        rotation: "-=10",
        opacity: 0,
        scale: 0.9,
        duration: reduceMotion ? 0 : 0.45,
        ease: "power2.in",
        onComplete: () => {
          order.push(order.shift() as number)
          layout(true)
          gsap.delayedCall(reduceMotion ? 0 : 0.5, () => {
            animating = false
          })
        },
      })
    }

    const prev = () => {
      if (animating) return
      animating = true
      order.unshift(order.pop() as number)
      layout(true)
      gsap.delayedCall(reduceMotion ? 0 : 0.6, () => {
        animating = false
      })
    }

    const goTo = (cardIdx: number) => {
      if (animating || order[0] === cardIdx) return
      while (order[0] !== cardIdx) {
        order.push(order.shift() as number)
      }
      layout(true)
    }

    // Initial fan (no animation to avoid a flash)
    layout(false)

    // Controls
    document.querySelector("[data-stack-next]")?.addEventListener("click", next)
    document.querySelector("[data-stack-prev]")?.addEventListener("click", prev)
    cards.forEach((card, i) => {
      card.addEventListener("click", () => {
        if (order[0] === i) next()
        else goTo(i)
      })
    })
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)))

    // Auto-advance, paused on hover
    if (!reduceMotion) {
      let timer = window.setInterval(next, 4500)
      const media = stack.closest<HTMLElement>("[data-hero-media]") ?? stack
      media.addEventListener("mouseenter", () => window.clearInterval(timer))
      media.addEventListener("mouseleave", () => {
        timer = window.setInterval(next, 4500)
      })
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStack)
  } else {
    initStack()
  }
</script>
