---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<section class="hero" id="top">
  <div class="hero__background" aria-hidden="true">
    <video
      src={`${baseUrl}video/colorflow-animation.mp4`}
      title="Hero background animation"
      loading="lazy"
      allow="autoplay; encrypted-media"
      referrerpolicy="strict-origin-when-cross-origin"
    ></video>
  </div>

  <div class="container-fluid hero__content">
    <div class="row align-items-center justify-content-center g-5">
      <div class="col-lg-6">
        <span class="h3 d-block mb-3">Creative Developer | Product Founder</span>
        <h2 class="h1 display-1 fw-bold mb-4 text-dark" style="line-height: 1.05;">
          Thoughtfully designed from the first <span class="text-primary">pixel.</span>
        </h2>
      </div>
      <div class="col-lg-5">
        <video
          class="object-fit-fill hero-video"
          src={`${baseUrl}video/mosaic-pixel.webm`}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Animated website scroll preview"
        ></video>
      </div>
    </div>
  </div>
</section>
