---
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;

---

<section class="hero" id="top">
          
  <div class="container-fluid">

    <div class="row align-items-center  g-5">
     <div class="col-lg-12 ">
        <!-- <h1 class="h3 name-header">Nolan Patterson</h1> -->
        <span class="h3 d-block mb-3">Creative Developer | Product Founder</span>
        <h2 class="h1 display-3 fw-bold mb-4 text-dark" style="line-height: 1.05;">
          Thoughtfully designed from the first <span class="text-primary">pixel.</span>
        </h2>
      </div>
  <a
    href="#work"
    class="scroll-cue text-decoration-none"
    aria-label="Scroll to work"
  >
    <span class="text-dark">Scroll</span>
    <span class="line bg-dark"></span>
  </a>
     
     
    </div>
  </div>


     <video
              class="hero-video"
              src={`${baseUrl}video/sideways-scroll.webm`}
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              aria-label="Animated website scroll preview"
            ></video>
</section>
