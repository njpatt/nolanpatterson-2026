---
interface Props {
  menuId?: string;
}
const { menuId = 'mainNav' } = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const links = [
  { label: 'Work', href: `${baseUrl}#work` },
  { label: 'About', href: `${baseUrl}#about` },
  { label: 'Blog', href: `${baseUrl}blog` },
  { label: 'Contact', href: `${baseUrl}#contact` },
];
---

<nav class="site-nav navbar navbar-expand-lg py-3" aria-label="Main navigation">
  <div class="container-fluid px-3 px-md-4 px-xl-5">
    <a class="navbar-brand brand-mark" href={baseUrl}>Nolan Patterson</a>

    <button class="navbar-toggler" type="button"
      data-bs-toggle="collapse" data-bs-target={`#${menuId}`}
      aria-controls={menuId} aria-expanded="false" aria-label="Toggle navigation">
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id={menuId}>
      <ul class="navbar-nav align-items-lg-center gap-lg-4 gap-2 mt-3 mt-lg-0">
        {links.map((link) => (
          <li class="nav-item"><a class="nav-link" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</nav>
