---
const projects = [
  {
    category: "professional",
    title: "University of Miami",
    kind: "Custom Website",
    desc: "Collaborative effort with designers and developers to create a modern, responsive site for the University of Miami's athletic fund, The Hurricane Club.",
    img: "/images/work/miami.jpg",
    slides: [
      "/images/work/miami.jpg",
      "/images/work/miami.jpg",
      "/images/work/miami.jpg",
    ],
    tags: ["Bootstrap", "Adobe XD", "Custom"],
  },
  {
    category: "professional",
    title: "Terra Goods",
    kind: "E-commerce",
    desc: "Headless storefront with a streamlined mobile checkout and CMS.",
    img: "/images/work/houston.jpg",
    slides: [
      "/images/work/houston.jpg",
      "/images/work/houston.jpg",
      "/images/work/houston.jpg",
    ],
    tags: ["Astro", "Stripe", "Sanity"],
  },
  {
    category: "professional",
    title: "Fieldnote",
    kind: "Web App",
    desc: "Collaborative research tool focused on speed and accessibility.",
    img: "/images/work/minnesota.jpg",
    slides: [
      "/images/work/minnesota.jpg",
      "/images/work/minnesota.jpg",
      "/images/work/minnesota.jpg",
    ],
    tags: ["Next.js", "Postgres", "a11y"],
  },
  {
    category: "professional",
    title: "Oklahoma State University",
    kind: "Design + Build",
    desc: "Identity and component library for a growing climate startup.",
    img: "/images/work/ok-state.jpg",
    slides: [
      "/images/work/ok-state.jpg",
      "/images/work/ok-state.jpg",
      "/images/work/ok-state.jpg",
    ],
    tags: ["Design System", "Figma", "CSS"],
  },
  {
    category: "professional",
    title: "Clay & Kiln",
    kind: "Ceramics",
    desc: "An ongoing series of hand-thrown stoneware in earthy glazes.",
    img: "/images/work/central-arkansas.jpg",
    slides: [
      "/images/work/central-arkansas.jpg",
      "/images/work/central-arkansas.jpg",
      "/images/work/central-arkansas.jpg",
    ],
    tags: ["Pottery", "Craft"],
  },
  {
    category: "professional",
    title: "Field Frames",
    kind: "Film Photography",
    desc: "Golden-hour landscapes shot on 35mm during weekend hikes.",
    img: "/images/work/virginia.jpg",
    slides: [
      "/images/work/virginia.jpg",
      "/images/work/virginia.jpg",
      "/images/work/virginia.jpg",
    ],
    tags: ["35mm", "Landscape"],
  },
];
---

<section class="section" id="work">
  <div class="container">
    <div class="row align-items-end mb-5 reveal">
      <div class="col-md-8">
        <span class=" d-block mb-2 text-dark font-bold">Selected Work</span>
        <h2 class="display-5 fw-bold mb-0 text-accent">
          Professional projects &amp; creative side quests.
        </h2>
      </div>
      <div class="col-md-4 mt-3 mt-md-0">
        <p class="text-muted-earth mb-0 text-md-end">
          A mix of client work and things I make purely because I enjoy the
          craft. Filter to explore.
        </p>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4 reveal" data-filter-group>
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="professional">Professional</button
      >
      <button class="filter-btn" data-filter="creative">Creative</button>
    </div>

    <div class="row g-4" data-stagger data-work-grid>
      {
        projects.slice(0, 3).map((p, index) => (
          <div
            class="col-md-6 col-lg-4 work-item"
            data-category={p.category}
            data-stagger-item
          >
            <article
              class="work-card"
              data-work-link
              data-title={p.title}
              data-kind={p.kind}
              data-desc={p.desc}
              data-img={p.img}
              data-slides={p.slides.join("|")}
              data-tags={p.tags.join(",")}
              tabindex="0"
              role="button"
              aria-label={`Open details for ${p.title}`}
            >
              <div class="work-card__img">
                <div
                  id={`work-carousel-${index}`}
                  class="carousel slide work-card__carousel"
                  data-bs-ride="carousel"
                  data-bs-interval="3500"
                >
                  <div class="carousel-indicators">
                    {p.slides.map((_, slideIndex) => (
                      <button
                        type="button"
                        data-bs-target={`#work-carousel-${index}`}
                        data-bs-slide-to={slideIndex}
                        class={slideIndex === 0 ? "active" : ""}
                        aria-current={slideIndex === 0 ? "true" : "false"}
                        aria-label={`Slide ${slideIndex + 1}`}
                      />
                    ))}
                  </div>
                  <div class="carousel-inner">
                    {p.slides.map((img, slideIndex) => (
                      <div
                        class={`carousel-item ${slideIndex === 0 ? "active" : ""}`}
                      >
                        <img
                          class="d-block w-100"
                          src={img}
                          alt={`${p.title} — ${p.kind}`}
                          loading="lazy"
                        />
                      </div>
                    ))}
                  </div>
                  <button
                    class="carousel-control-prev"
                    type="button"
                    data-bs-target={`#work-carousel-${index}`}
                    data-bs-slide="prev"
                  >
                    <span
                      class="carousel-control-prev-icon"
                      aria-hidden="true"
                    />
                    <span class="visually-hidden">Previous</span>
                  </button>
                  <button
                    class="carousel-control-next"
                    type="button"
                    data-bs-target={`#work-carousel-${index}`}
                    data-bs-slide="next"
                  >
                    <span
                      class="carousel-control-next-icon"
                      aria-hidden="true"
                    />
                    <span class="visually-hidden">Next</span>
                  </button>
                </div>
              </div>
              <div class="p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="slide-tag">{p.kind}</span>
                  <span class="small text-muted-earth text-capitalize">
                    {p.category}
                  </span>
                </div>
                <h3 class="h4 mb-2">{p.title}</h3>
                <p class="text-muted-earth small mb-3">{p.desc}</p>
                <div>
                  {p.tags.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <div class="row g-4 mt-4 work-grid__more" data-work-grid data-stagger>
      {
        projects.slice(3).map((p, index) => (
          <div
            class="col-md-6 col-lg-4 work-item"
            data-category={p.category}
            data-stagger-item
          >
            <article
              class="work-card"
              data-work-link
              data-title={p.title}
              data-kind={p.kind}
              data-desc={p.desc}
              data-img={p.img}
              data-slides={p.slides.join("|")}
              data-tags={p.tags.join(",")}
              tabindex="0"
              role="button"
              aria-label={`Open details for ${p.title}`}
            >
              <div class="work-card__img">
                <div
                  id={`work-carousel-extra-${index}`}
                  class="carousel slide work-card__carousel"
                  data-bs-ride="carousel"
                  data-bs-interval="3500"
                >
                  <div class="carousel-indicators">
                    {p.slides.map((_, slideIndex) => (
                      <button
                        type="button"
                        data-bs-target={`#work-carousel-extra-${index}`}
                        data-bs-slide-to={slideIndex}
                        class={slideIndex === 0 ? "active" : ""}
                        aria-current={slideIndex === 0 ? "true" : "false"}
                        aria-label={`Slide ${slideIndex + 1}`}
                      />
                    ))}
                  </div>
                  <div class="carousel-inner">
                    {p.slides.map((img, slideIndex) => (
                      <div
                        class={`carousel-item ${slideIndex === 0 ? "active" : ""}`}
                      >
                        <img
                          class="d-block w-100"
                          src={img}
                          alt={`${p.title} — ${p.kind}`}
                          loading="lazy"
                        />
                      </div>
                    ))}
                  </div>
                  <button
                    class="carousel-control-prev"
                    type="button"
                    data-bs-target={`#work-carousel-extra-${index}`}
                    data-bs-slide="prev"
                  >
                    <span
                      class="carousel-control-prev-icon"
                      aria-hidden="true"
                    />
                    <span class="visually-hidden">Previous</span>
                  </button>
                  <button
                    class="carousel-control-next"
                    type="button"
                    data-bs-target={`#work-carousel-extra-${index}`}
                    data-bs-slide="next"
                  >
                    <span
                      class="carousel-control-next-icon"
                      aria-hidden="true"
                    />
                    <span class="visually-hidden">Next</span>
                  </button>
                </div>
              </div>
              <div class="p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="slide-tag">{p.kind}</span>
                  <span class="small text-muted-earth text-capitalize">
                    {p.category}
                  </span>
                </div>
                <h3 class="h4 mb-2">{p.title}</h3>
                <p class="text-muted-earth small mb-3">{p.desc}</p>
                <div>
                  {p.tags.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <div class="d-flex justify-content-center mt-4">
      <button
        class="btn btn-outline-earth load-more-btn"
        type="button"
        data-load-more
        aria-expanded="false"
      >
        Load more
      </button>
    </div>
  </div>

  <div
    class="work-modal"
    id="work-modal"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    <div class="work-modal__overlay" data-modal-close></div>
    <div class="work-modal__dialog modal-dialog-center">
      <button
        class="work-modal__close"
        type="button"
        aria-label="Close project details"
        data-modal-close>&times;</button
      >
      <div class="work-modal__image">
        <div
          id="work-modal-carousel"
          class="carousel slide work-modal__carousel"
          data-bs-ride="carousel"
          data-bs-interval="3500"
        >
          <div class="carousel-indicators" data-modal-indicators></div>
          <div class="carousel-inner" data-modal-carousel-items></div>
          <button
            class="carousel-control-prev"
            type="button"
            data-bs-target="#work-modal-carousel"
            data-bs-slide="prev"
          >
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button
            class="carousel-control-next"
            type="button"
            data-bs-target="#work-modal-carousel"
            data-bs-slide="next"
          >
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
      <div class="work-modal__body">
        <span class="slide-tag" data-modal-kind></span>
        <h3 class="h3 mt-3" data-modal-title></h3>
        <p class="text-muted-earth mb-3" data-modal-desc></p>
        <div class="d-flex flex-wrap gap-2" data-modal-tags></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { Carousel } from "bootstrap";

  type Project = {
    category: string;
    title: string;
    kind: string;
    desc: string;
    img: string;
    slides: string[];
    tags: string[];
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>(".work-item");
  const extraRow = document.querySelector<HTMLElement>(".work-grid__more");
  const loadMoreButton = document.querySelector<HTMLButtonElement>("[data-load-more]");
  const modal = document.getElementById("work-modal");
  const modalKind = modal?.querySelector<HTMLElement>("[data-modal-kind]");
  const modalTitle = modal?.querySelector<HTMLElement>("[data-modal-title]");
  const modalDesc = modal?.querySelector<HTMLElement>("[data-modal-desc]");
  const modalTags = modal?.querySelector<HTMLElement>("[data-modal-tags]");
  const modalIndicators = modal?.querySelector<HTMLElement>(
    "[data-modal-indicators]",
  );
  const modalCarouselItems = modal?.querySelector<HTMLElement>(
    "[data-modal-carousel-items]",
  );
  const modalLinks = document.querySelectorAll<HTMLElement>("[data-work-link]");
  const modalCloseButtons =
    document.querySelectorAll<HTMLElement>("[data-modal-close]");

  function renderModalSlides(project: Project) {
    if (!modalIndicators || !modalCarouselItems) return;

    const slides = project.slides.length > 0 ? project.slides : [project.img];

    modalIndicators.innerHTML = slides
      .map((_, slideIndex) => {
        const activeClass = slideIndex === 0 ? "active" : "";
        return `<button type="button" data-bs-target="#work-modal-carousel" data-bs-slide-to="${slideIndex}" class="${activeClass}" aria-current="${slideIndex === 0 ? "true" : "false"}" aria-label="Slide ${slideIndex + 1}"></button>`;
      })
      .join("");

    modalCarouselItems.innerHTML = slides
      .map((slide, slideIndex) => {
        const activeClass = slideIndex === 0 ? "active" : "";
        return `<div class="carousel-item ${activeClass}"><img src="${slide}" class="d-block w-100" alt="${project.title} — ${project.kind}" loading="lazy" /></div>`;
      })
      .join("");

    const modalCarousel = document.getElementById("work-modal-carousel");
    if (modalCarousel) {
      const carouselInstance = Carousel.getOrCreateInstance(modalCarousel);
      carouselInstance.to(0);
    }
  }

  function openModal(project: Project) {
    if (!modal || !modalKind || !modalTitle || !modalDesc || !modalTags) return;

    modalKind.textContent = project.kind;
    modalTitle.textContent = project.title;
    modalDesc.textContent = project.desc;
    modalTags.innerHTML = "";
    renderModalSlides(project);

    project.tags.forEach((tag: string) => {
      const chip = document.createElement("span");
      chip.className = "chip";
      chip.textContent = tag;
      modalTags.appendChild(chip);
    });

    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("modal-open");
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const filter = btn.dataset.filter;

      items.forEach((item) => {
        const match = filter === "all" || item.dataset.category === filter;
        item.style.display = match ? "" : "none";
      });

      if (extraRow && loadMoreButton) {
        extraRow.classList.remove("is-expanded");
        loadMoreButton.setAttribute("aria-expanded", "false");
        loadMoreButton.textContent = "Load more";
      }
    });
  });

  if (extraRow && loadMoreButton) {
    loadMoreButton.addEventListener("click", () => {
      const isExpanded = extraRow.classList.toggle("is-expanded");
      loadMoreButton.setAttribute("aria-expanded", String(isExpanded));
      loadMoreButton.textContent = isExpanded ? "Show less" : "Load more";
    });
  }

  modalLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const title = link.dataset.title || "";
      const kind = link.dataset.kind || "";
      const desc = link.dataset.desc || "";
      const img = link.dataset.img || "";
      const slides = link.dataset.slides
        ? link.dataset.slides.split("|")
        : [img];
      const tags = link.dataset.tags ? link.dataset.tags.split(",") : [];

      openModal({ title, kind, desc, img, slides, category: "", tags });
    });
  });

  modalLinks.forEach((link) => {
    link.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        link.click();
      }
    });
  });

  document
    .querySelectorAll<HTMLElement>(
      ".work-card__carousel .carousel-control-prev, .work-card__carousel .carousel-control-next, .work-card__carousel .carousel-indicators button",
    )
    .forEach((control) => {
      control.addEventListener("click", (event) => {
        event.stopPropagation();
      });
    });

  modalCloseButtons.forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });
</script>
