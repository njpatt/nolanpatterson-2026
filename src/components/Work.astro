---
const projects = [
  {
    category: "professional",
    title: "Meridian Analytics",
    kind: "SaaS Dashboard",
    desc: "Real-time analytics platform with custom charting and role-based access.",
    img: "/images/project-dashboard.png",
    tags: ["React", "TypeScript", "Node"],
  },
  {
    category: "professional",
    title: "Terra Goods",
    kind: "E-commerce",
    desc: "Headless storefront with a streamlined mobile checkout and CMS.",
    img: "/images/project-mobile.png",
    tags: ["Astro", "Stripe", "Sanity"],
  },
  {
    category: "professional",
    title: "Fieldnote",
    kind: "Web App",
    desc: "Collaborative research tool focused on speed and accessibility.",
    img: "/images/project-webapp.png",
    tags: ["Next.js", "Postgres", "a11y"],
  },
  {
    category: "professional",
    title: "Atlas Brand System",
    kind: "Design + Build",
    desc: "Identity and component library for a growing climate startup.",
    img: "/images/project-branding.png",
    tags: ["Design System", "Figma", "CSS"],
  },
  {
    category: "creative",
    title: "Clay & Kiln",
    kind: "Ceramics",
    desc: "An ongoing series of hand-thrown stoneware in earthy glazes.",
    img: "/images/hobby-ceramics.png",
    tags: ["Pottery", "Craft"],
  },
  {
    category: "creative",
    title: "Field Frames",
    kind: "Film Photography",
    desc: "Golden-hour landscapes shot on 35mm during weekend hikes.",
    img: "/images/hobby-photography.png",
    tags: ["35mm", "Landscape"],
  },
]
---

<section class="section" id="work" style="background-color: var(--background);">
  <div class="container">
    <div class="row align-items-end mb-5 reveal">
      <div class="col-md-8">
        <span class="eyebrow d-block mb-2">Selected Work</span>
        <h2 class="display-5 fw-bold mb-0">
          Professional projects &amp; creative side quests.
        </h2>
      </div>
      <div class="col-md-4 mt-3 mt-md-0">
        <p class="text-muted-earth mb-0 text-md-end">
          A mix of client work and things I make purely because I enjoy the
          craft. Filter to explore.
        </p>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4 reveal" data-filter-group>
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="professional">Professional</button>
      <button class="filter-btn" data-filter="creative">Creative</button>
    </div>

    <div class="row g-4" data-stagger data-work-grid>
      {
        projects.map((p, index) => (
          <div
            class="col-md-6 col-lg-4 work-item"
            data-category={p.category}
            data-stagger-item
          >
            <a
              href="#work-modal"
              class="text-decoration-none"
              data-work-link
              data-title={p.title}
              data-kind={p.kind}
              data-desc={p.desc}
              data-img={p.img}
              data-tags={p.tags.join(",")}
            >
            <article class="work-card">
              <div class="work-card__img">
                <img class="img-fluid" src={p.img} alt={`${p.title} — ${p.kind}`} loading="lazy" />
              </div>
              <div class="p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="slide-tag">{p.kind}</span>
                  <span class="small text-muted-earth text-capitalize">
                    {p.category}
                  </span>
                </div>
                <h3 class="h5 mb-2">{p.title}</h3>
                <p class="text-muted-earth small mb-3">{p.desc}</p>
                <div>
                  {p.tags.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              </div>
            </article>
            </a>
          </div>
        ))
      }
    </div>
  </div>

  <div class="work-modal" id="work-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="work-modal__overlay" data-modal-close></div>
    <div class="work-modal__dialog modal-dialog-center">
      <button class="work-modal__close" type="button" aria-label="Close project details" data-modal-close>&times;</button>
      <div class="work-modal__image">
        <img class="img-fluid" src="" alt="" data-modal-img />
      </div>
      <div class="work-modal__body">
        <span class="slide-tag" data-modal-kind></span>
        <h3 class="h3 mt-3" data-modal-title></h3>
        <p class="text-muted-earth mb-3" data-modal-desc></p>
        <div class="d-flex flex-wrap gap-2" data-modal-tags></div>
      </div>
    </div>
  </div>
</section>

<script>
  type Project = {
    category: string
    title: string
    kind: string
    desc: string
    img: string
    tags: string[]
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]")
  const items = document.querySelectorAll<HTMLElement>(".work-item")
  const modal = document.getElementById("work-modal")
  const modalKind = modal?.querySelector<HTMLElement>("[data-modal-kind]")
  const modalTitle = modal?.querySelector<HTMLElement>("[data-modal-title]")
  const modalDesc = modal?.querySelector<HTMLElement>("[data-modal-desc]")
  const modalTags = modal?.querySelector<HTMLElement>("[data-modal-tags]")
  const modalImg = modal?.querySelector<HTMLImageElement>("[data-modal-img]")
  const modalLinks = document.querySelectorAll<HTMLAnchorElement>("[data-work-link]")
  const modalCloseButtons = document.querySelectorAll<HTMLElement>("[data-modal-close]")

  function openModal(project: Project) {
    if (!modal || !modalKind || !modalTitle || !modalDesc || !modalTags || !modalImg) return

    modalKind.textContent = project.kind
    modalTitle.textContent = project.title
    modalDesc.textContent = project.desc
    modalTags.innerHTML = ""

    project.tags.forEach((tag: string) => {
      const chip = document.createElement("span")
      chip.className = "chip"
      chip.textContent = tag
      modalTags.appendChild(chip)
    })

    modalImg.src = project.img
    modalImg.alt = `${project.title} — ${project.kind}`

    modal.classList.add("open")
    modal.setAttribute("aria-hidden", "false")
    document.body.classList.add("modal-open")
  }

  function closeModal() {
    if (!modal) return
    modal.classList.remove("open")
    modal.setAttribute("aria-hidden", "true")
    document.body.classList.remove("modal-open")
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("active"))
      btn.classList.add("active")
      const filter = btn.dataset.filter

      items.forEach((item) => {
        const match = filter === "all" || item.dataset.category === filter
        item.style.display = match ? "" : "none"
      })
    })
  })

  modalLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault()
      const title = link.dataset.title || ""
      const kind = link.dataset.kind || ""
      const desc = link.dataset.desc || ""
      const img = link.dataset.img || ""
      const tags = link.dataset.tags ? link.dataset.tags.split(",") : []

      openModal({ title, kind, desc, img, category: "", tags })
    })
  })

  modalCloseButtons.forEach((button) => {
    button.addEventListener("click", closeModal)
  })

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal()
    }
  })
</script>
