---
import WorkCard from "./WorkCard.astro";

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<section class="section app-store-section" id="work">
  <div class="container">
    <header class="app-store__header reveal">
      <div>
        <span class="d-block mb-2 text-dark font-bold">Selected Work</span>
        <h2 class="display-5 fw-bold mb-0 text-primary">
          Professional Websites &amp; creative works.
        </h2>
      </div>
    </header>

    <div class="row g-4 app-store__grid">
      <div class="col-lg-4">
        <WorkCard
          title="University of Miami - Athletic Fund"
          kind="Custom Website"
          desc="Collaborative effort with designers and developers to create a modern, responsive site for the University of Miami's athletic fund, The Hurricane Club."
          image={`${baseUrl}images/work/miami.jpg`}
          tags={["Bootstrap", "Adobe XD", "Custom"]}
        />
      </div>

      <div class="col-lg-3">
        <WorkCard
          title="Terra Goods"
          kind="E-commerce"
          desc="Headless storefront with a streamlined mobile checkout and CMS."
          image={`${baseUrl}images/work/houston.jpg`}
          tags={["Astro", "Stripe", "Sanity"]}
        />
      </div>

      <div class="col-lg-5">
        <WorkCard
          title="University of Minnesota - Athletic Fund"
          kind="Website Redesign"
          desc="Collaborative research tool focused on speed and accessibility."
          image={`${baseUrl}images/work/minnesota.jpg`}
          tags={["Next.js", "Postgres", "a11y"]}
        />
      </div>

      <div class="col-lg-5">
        <WorkCard
          title="Oklahoma State University"
          kind="Design + Build"
          desc="Identity and component library for a growing climate startup."
          image={`${baseUrl}images/work/ok-state.jpg`}
          tags={["Design System", "Figma", "CSS"]}
        />
      </div>

      <div class="col-lg-3">
        <WorkCard
          title="Clay & Kiln"
          kind="Ceramics"
          desc="An ongoing series of hand-thrown stoneware in earthy glazes."
          image={`${baseUrl}images/work/central-arkansas.jpg`}
          tags={["Pottery", "Craft"]}
        />
      </div>

      <div class="col-lg-4">
        <WorkCard
          title="Field Frames"
          kind="Film Photography"
          desc="Golden-hour landscapes shot on 35mm during weekend hikes."
          image={`${baseUrl}images/work/virginia.jpg`}
          tags={["35mm", "Landscape"]}
        />
      </div>
    </div>

    <div class="app-store__modal" id="app-store-modal" aria-hidden="true">
      <div class="app-store__backdrop" data-close-modal></div>
      <div
        class="app-store__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="app-store-modal-title"
      >
        <button
          class="app-store__close"
          type="button"
          aria-label="Close project details"
          data-close-modal
        >
          &times;
        </button>

        <div class="app-store__dialog-media">
          <img id="app-store-modal-image" src="" alt="" />
        </div>

        <div class="app-store__dialog-body">
          <span class="app-card__eyebrow" id="app-store-modal-kind"></span>
          <h3 id="app-store-modal-title"></h3>
          <p id="app-store-modal-desc"></p>
          <div id="app-store-modal-tags" class="d-flex flex-wrap gap-2 mt-3">
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const appCards = document.querySelectorAll<HTMLElement>("[data-card]");
    const modal = document.getElementById("app-store-modal");
    const modalImage = document.getElementById("app-store-modal-image");
    const modalKind = document.getElementById("app-store-modal-kind");
    const modalTitle = document.getElementById("app-store-modal-title");
    const modalDesc = document.getElementById("app-store-modal-desc");
    const modalTags = document.getElementById("app-store-modal-tags");
    const closeButtons =
      document.querySelectorAll<HTMLElement>("[data-close-modal]");

    const openModal = (card: HTMLElement) => {
      if (
        !modal ||
        !modalImage ||
        !modalKind ||
        !modalTitle ||
        !modalDesc ||
        !modalTags
      )
        return;

      const title = card.dataset.title || "";
      const kind = card.dataset.kind || "";
      const desc = card.dataset.desc || "";
      const image = card.dataset.image || "";
      const tags = card.dataset.tags ? card.dataset.tags.split(",") : [];

      modalImage.src = image;
      modalImage.alt = title;
      modalKind.textContent = kind;
      modalTitle.textContent = title;
      modalDesc.textContent = desc;
      modalTags.innerHTML = "";

      tags.forEach((tag) => {
        const chip = document.createElement("span");
        chip.className = "chip";
        chip.textContent = tag;
        modalTags.appendChild(chip);
      });

      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
    };

    appCards.forEach((card) => {
      card.addEventListener("click", () => openModal(card));

      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openModal(card);
        }
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeModal);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeModal();
      }
    });
  </script>
</section>
