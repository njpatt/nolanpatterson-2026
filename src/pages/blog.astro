---
import Layout from "../layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL;
const posts = [
  {
    title: "Designing with earth tones on the web",
    excerpt:
      "Why muted, natural palettes feel calmer — and how to build an accessible one with real contrast.",
    date: "Jul 2026",
    readingTime: "6 min read",
    category: "Design",
    img: `${baseUrl}images/blog-design.png`,
  },
  {
    title: "Scroll-driven animation with GSAP & Astro",
    excerpt:
      "A practical walkthrough of ScrollTrigger, from simple reveals to a hero that hands off to the next section.",
    date: "Jun 2026",
    readingTime: "9 min read",
    category: "Development",
    img: `${baseUrl}images/blog-css.png`,
  },
  {
    title: "What pottery taught me about shipping software",
    excerpt:
      "Lessons from the wheel: embrace iteration, respect the material, and know when a piece is done.",
    date: "May 2026",
    readingTime: "4 min read",
    category: "Notes",
    img: `${baseUrl}images/hobby-ceramics.png`,
  },
  {
    title: "Building fast, accessible storefronts",
    excerpt:
      "The performance and a11y checklist I run through before any e-commerce build goes live.",
    date: "Apr 2026",
    readingTime: "7 min read",
    category: "Development",
    img: `${baseUrl}images/project-mobile.png`,
  },
  {
    title: "A weekend with 35mm film",
    excerpt:
      "Slowing down, shooting less, and why constraints make me a sharper problem-solver at work.",
    date: "Mar 2026",
    readingTime: "5 min read",
    category: "Notes",
    img: `${baseUrl}images/hobby-photography.png`,
  },
  {
    title: "Component libraries that people actually use",
    excerpt:
      "Notes on documentation, naming, and the small things that make a design system stick.",
    date: "Feb 2026",
    readingTime: "8 min read",
    category: "Design",
    img: `${baseUrl}images/project-branding.png`,
  },
];
---

       <!-- I have spent the last 10 years learning what good user expereience means to me. Starting with learning about customer pain points that build into solutions that are marketable. Ive develed into many aspects of the user expereince from web design, graphic design, advertisement, content retention, as well as good old fashion user feedback. With my years of cultivating knowledge and expereience, I am using that knowledge first hand to run a sucessful physical goods business. I am utliizing all available technology to create meanininful products and interactions that still feel human. In today's climate it is easy to find a genuine human moment with so much AI. AI is prone to be misued or overused. There is no one size fits all for AI usage. It largely depends on the abikity and intentions of the human feeding the information. The way I see AI is as a tool or a sort of supercomputer that anyone can have access to. Always use AI carefully and schepticely, assume that it is going to present partially incorrect information. Too many people fall into the trap of reading something at face value as the aboslute truth. It is important to compare sources, AI is no different. However as a chronic overresearcher for the minute details in every asepct of my life, I love gemini's ability to aggregate mutiple sources and give a sort of devils advocate mass consenus reading. For example last weekend I was researching local hikes in my area. Admittedly I am no longer in peak hiking shape and I wanted to go on a hike that I wouldnt feel as if Im dying by the end of it. So I narroowed my GOoogle Mpas search to hikes in my area, under 2 hours, relatively easy with a pretty view. Gemini was able to provide a list of several hikes nearby and quickly bulleted the overview based on the physical requirement of the hike, such as steep 188 steps to the peak, but worth the view at the top. It is things like this that brings me joy and rather than the fear of exponential technology growth, it is more celar to see that this is the next generation of technology boom.  I care about the details
          most people never notice: the easing on a transition, a keyboard trap
          that shouldn&apos;t exist, a layout that holds up on every screen. -->

<Layout
  title="Blog — Nolan Patterson"
  description="Writing on web development, design, and the crafts that keep me curious."
>
  <section class="blog-hero section pb-4">
    <div class="container">
      <span class="eyebrow d-block mb-2">The Blog</span>
      <h1 class="display-4 fw-bold mb-3" style="max-width: 20ch;">
        Notes on code, craft &amp; everything between.
      </h1>
      <p class="fs-5 text-muted-earth mb-0" style="max-width: 42rem;">
        A placeholder feed for now — thoughts on web development, design
        systems, and the analog hobbies that keep me curious. Real posts coming
        soon.
      </p>
    </div>
  </section>

  <section class="section pt-4">
    <div class="container">
      <div class="row g-4" data-stagger>
        {
          posts.map((post) => (
            <div class="col-md-6 col-lg-4" data-stagger-item>
              <article class="post-card">
                <div class="post-card__img">
                  <img src={post.img} alt={post.title} loading="lazy" />
                </div>
                <div class="p-4 d-flex flex-column h-100">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="slide-tag">{post.category}</span>
                    <span class="small text-muted-earth">
                      {post.readingTime}
                    </span>
                  </div>
                  <h2 class="h5 mb-2">{post.title}</h2>
                  <p class="text-muted-earth small mb-3">{post.excerpt}</p>
                  <div class="mt-auto d-flex justify-content-between align-items-center">
                    <span class="small text-muted-earth">{post.date}</span>
                    <a
                      href="#"
                      class="text-decoration-none fw-semibold"
                      style="color: var(--clay-dark);"
                    >
                      Read &rarr;
                    </a>
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>

      <div class="text-center mt-5">
        <a href={`${baseUrl}#work`} class="btn btn-outline-earth">Back to portfolio</a>
      </div>
    </div>
  </section>
</Layout>
